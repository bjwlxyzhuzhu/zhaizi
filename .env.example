# 复制为 .env 后修改
# 必改：令牌签名密钥（任意 32 位以上随机串）
ZZ_JWT_SECRET=replace-with-a-long-random-secret

# 机构署名：参赛评审版（双盲）请全部留空；正式使用时再填写真实单位
ZZ_ORG_LINE=
ZZ_ORG_SHORT=
# 图片署名（留空则显示“藏品照片经馆藏单位授权用于研究”）
ZZ_IMAGE_CREDIT=

# 对外端口
ZZ_PORT=8080

# 大模型（也可登录 admin 后在“系统设置”里填写；留空则为演示模型）
ZZ_MODEL_API_KEY=
ZZ_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZZ_MODEL_NAME=qwen3.8-max

# 使用 PostgreSQL 时取消注释（并以 --profile pg 启动）
# DATABASE_URL=postgresql+psycopg://zhaizi:change-me@postgres/zhaizi
