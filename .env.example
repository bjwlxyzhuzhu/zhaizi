# 复制为 .env 后修改
# 必改：令牌签名密钥（任意 32 位以上随机串）
ZZ_JWT_SECRET=replace-with-a-long-random-secret

# 首次初始化必填：自行生成至少 12 位强密码（已有数据卷不改动账号密码）
ZZ_BOOTSTRAP_PASSWORD=

# 机构署名：参赛评审版（双盲）请全部留空；正式使用时再填写真实单位
ZZ_ORG_LINE=
ZZ_ORG_SHORT=
# 图片署名（留空则显示“藏品照片经馆藏单位授权用于研究”）
ZZ_IMAGE_CREDIT=

# 对外端口
ZZ_PORT=8080

# 大模型（也可登录管理后台“模型与 API 设置”填写；留空则为库内检索摘引）
ZZ_MODEL_API_KEY=
ZZ_MODEL_BASE_URL=https://token.agentone.work/v1
# 在后台选择或手动填写服务商可用的模型 ID，不预设固定模型。
ZZ_MODEL_NAME=

# 使用 PostgreSQL 时取消注释（并以 --profile pg 启动）
# DATABASE_URL=postgresql+psycopg://zhaizi:change-me@postgres/zhaizi
